<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1016"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textDisplay"
        android:layout_width="320dp"
        android:layout_height="90dp"
        android:background="@drawable/calculator_display"
        android:ellipsize="start"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:padding="16dp"
        android:text="@string/display_zero"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />


    <GridLayout
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:columnCount="4"
        android:rowCount="5">


        <!-- ROW 1 -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonClear"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="0"
            android:layout_column="0"
            android:background="@drawable/calculator_button"
            app:backgroundTint="@null"
            android:text="@string/button_clear"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonBackspace"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="0"
            android:layout_column="1"
            android:background="@drawable/calculator_button"
            app:backgroundTint="@null"
            android:text="@string/button_backspace"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonMultiply"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="0"
            android:layout_column="2"
            android:background="@drawable/calculator_button"
            app:backgroundTint="@null"
            android:text="@string/button_multiply"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonDivide"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="0"
            android:layout_column="3"
            android:background="@drawable/calculator_button"
            app:backgroundTint="@null"
            android:text="@string/button_divide"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- ROW 2 -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button7"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="1"
            android:layout_column="0"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_7"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button8"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="1"
            android:layout_column="1"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_8"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button9"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="1"
            android:layout_column="2"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_9"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonSubtract"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="1"
            android:layout_column="3"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_subtract"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ROW 3 -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button4"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="2"
            android:layout_column="0"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_4"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button5"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="2"
            android:layout_column="1"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_5"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button6"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="2"
            android:layout_column="2"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_6"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonAdd"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="2"
            android:layout_column="3"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_add"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ROW 4 -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button1"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="3"
            android:layout_column="0"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_1"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button2"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="3"
            android:layout_column="1"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_2"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button3"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="3"
            android:layout_column="2"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_3"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonEquals"
            android:layout_width="80dp"
            android:layout_height="128dp"
            android:layout_row="3"
            android:layout_rowSpan="2"
            android:layout_column="3"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_equals"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />


        <!-- ROW 5 -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button0"
            android:layout_width="160dp"
            android:layout_height="64dp"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnSpan="2"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonDecimal"
            android:layout_width="80dp"
            android:layout_height="64dp"
            android:layout_row="4"
            android:layout_column="2"
            android:background="@drawable/calculator_button"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/button_decimal"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </GridLayout>

</LinearLayout>